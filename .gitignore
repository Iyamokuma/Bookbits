# Dependencies
node_modules/

# Build output
dist/
.vercel/

# Local secrets & environment overrides
.env
.env.*
!.env.example

# Runtime uploads are not tracked, except the product covers migrated from the
# old PHP site — git is currently their only backup. The contents are excluded
# rather than the directory itself, because git will not descend into an
# ignored directory to apply the negations below.
public/uploads/*
!public/uploads/covers/
!public/uploads/blog/

# Archives & backups
*.zip
*.tar
*.tar.gz

# Cursor / IDE (do not publish agent or editor metadata)
.cursor/
.cursorrules
.agent/
agent-transcripts/
mcps/
*.cursor-*
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs & temp
*.log
npm-debug.log*
tmp/
temp/

# Vercel CLI link data and the env vars it pulls down
.vercel

# Real secrets stay local; the template is committed so a fresh clone knows
# which variables to fill in.
.env
.env.*
!.env.example
