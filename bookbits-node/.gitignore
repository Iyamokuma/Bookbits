node_modules/
.env
.env.*
!.env.example
# Runtime uploads are not tracked, except the product covers migrated from the
# old PHP site — git is currently their only backup. The contents are excluded
# rather than the directory itself, because git will not descend into an
# ignored directory to apply the negation below.
public/uploads/*
!public/uploads/covers/
npm-debug.log*
.DS_Store
*.log
