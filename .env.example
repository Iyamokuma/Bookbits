# ---------------------------------------------------------------
# Bookbits — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# Do NOT set NODE_ENV here. Vite reads this file, and NODE_ENV=development would
# make `npm run build` emit React's development bundle. The server defaults to
# development locally, and Vercel sets NODE_ENV=production for you.
PORT=3000

# Public base URL (no trailing slash). Used for payment callbacks + email links.
# On Vercel set this to your deployed URL, e.g. https://bookbits.vercel.app
BASE_URL=http://localhost:3000

# --- Supabase Postgres -------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the "Transaction pooler" (port 6543) for web apps.
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Supabase requires TLS. Leave true unless you know otherwise.
DATABASE_SSL=true

# --- Sessions ----------------------------------------------------------
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Admin dashboard ---------------------------------------------------
ADMIN_EMAIL=admin@bookbits.com
ADMIN_PASSWORD=change-me

# --- Google sign-in (suspended) ----------------------------------------
# Built and tested, but switched off. To enable, set both variables below.
# GOOGLE_CLIENT_ID comes from Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID (type: Web application). It is not a secret.
# Its "Authorised JavaScript origins" must list every origin you sign in from,
# e.g. http://localhost:5173 and your deployed URL.
GOOGLE_SIGNIN_ENABLED=false
GOOGLE_CLIENT_ID=

# --- Store identity ----------------------------------------------------
STORE_NAME=Books, Bits & Co
STORE_EMAIL=orders@booksandbits.com.ng
STORE_PHONE=+234 906 003 1555
WHATSAPP_PHONE=2349060031555
FACEBOOK_URL=https://www.facebook.com/share/1Baxort7ES/
INSTAGRAM_URL=https://www.instagram.com/booksbitsandco
CURRENCY_SYMBOL=₦
CURRENCY_CODE=NGN

# --- Supabase Storage (admin cover uploads) ----------------------------
# Required for any deployment with a read-only filesystem, including Vercel.
# Leave SUPABASE_SERVICE_KEY blank locally to write into public/uploads instead.
# Dashboard -> Project Settings -> API -> service_role key (a long JWT).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=covers

# --- Email (Resend) ----------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM_EMAIL=orders@bandb.site
MAIL_FROM_NAME=Books, Bits & Co

# --- Payment gateways --------------------------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
KLUMP_PUBLIC_KEY=
KLUMP_SECRET_KEY=
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=

# --- Meta Pixel & Conversions API --------------------------------------
# Events Manager -> Data sources -> your Pixel/Dataset -> Settings:
#   META_PIXEL_ID = the numeric Pixel ID shown at the top.
# Conversions API -> Set up manually -> Generate access token:
#   META_CAPI_ACCESS_TOKEN = the long EAA… token (keep secret).
META_CONVERSIONS_ENABLED=true
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
