{
  "name": "bookbits",
  "version": "1.0.0",
  "private": true,
  "description": "Books, Bits & Co — online bookstore (React + Express + Supabase Postgres)",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "db:push": "node scripts/push-schema.js",
    "db:migrate": "node scripts/migrate-from-mysql.js",
    "storage:init": "node scripts/init-storage.js",
    "mail:test": "node scripts/send-test-email.js"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "google-auth-library": "^11.0.2",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "resend": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "mysql2": "^3.10.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
