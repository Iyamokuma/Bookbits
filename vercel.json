{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    {
      "source": "/:section(book|blog|pages)/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|spider|Spider|crawler|Crawler|Preview|preview|facebookexternalhit|meta-externalagent|WhatsApp|Embedly|Iframely|vkShare|Mastodon|Cardyb|Google-InspectionTool|GoogleOther|Google-PageRenderer).*"
        }
      ],
      "destination": "/api/index"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
